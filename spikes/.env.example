# Copy to spikes/.env (never commit it).

# From your app at https://connect.challonge.com
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that app.
CHALLONGE_REDIRECT_URI=http://localhost:3000/api/challonge/oauth/callback

# Optional: override the scopes requested in S1 (space-separated).
# CHALLONGE_SCOPES=me tournaments:read tournaments:write matches:read matches:write participants:read participants:write

# The throwaway test tournament: its ID (preferred) or URL slug.
# S4 only runs if the tournament's name starts with "[SPIKE]".
SPIKE_TOURNAMENT_ID=

# Only if the test tournament belongs to a Challonge community.
# CHALLONGE_COMMUNITY_ID=
