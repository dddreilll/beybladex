# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings > API). For local dev, `npm run supabase:start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection used by the server (Drizzle) and by migrations.
# Local: postgresql://postgres:postgres@127.0.0.1:44322/postgres
# Hosted Supabase: use the transaction pooler (port 6543), so server instances share connections.
DATABASE_URL=

# Public base URL of this app.
APP_URL=http://localhost:3000

# Where "Request Early Access" on the landing page leads: a form or chat link, as an http(s) URL
# (optional: without it the button is shown disabled).
EARLY_ACCESS_URL=

# Who runs this deployment, as named in the Terms of Service (/terms) and Privacy Policy (/privacy),
# and the address people write to about them. Both optional: without a name the pages say
# "the operator of this site", and without an address they give no contact.
OPERATOR_NAME=
CONTACT_EMAIL=

# Web push for players (optional: without these the "Enable notifications" button is hidden).
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services, as mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com
