# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings > API). For local dev, `npm run supabase:start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection used by the server (Drizzle). Local: postgresql://postgres:postgres@127.0.0.1:44322/postgres
# Hosted Supabase: use the transaction pooler (port 6543), so server instances share connections.
DATABASE_URL=
# Optional, for `npm run db:migrate` only: the direct or session-pooler URL (port 5432).
# Leave empty locally; migrations then use DATABASE_URL.
DIRECT_DATABASE_URL=

# Public base URL of this app. The Challonge redirect URI is APP_URL + /api/challonge/oauth/callback.
APP_URL=http://localhost:3000

# Encrypts organizers' Challonge client secrets and tokens (AES-256-GCM).
# Format: v1:<base64 of 32 random bytes>. To rotate, prepend a new key: v2:<new>,v1:<old>.
# Generate one with: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEYS=

# Web push for players (optional: without these the "Enable notifications" button is hidden).
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services, as mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com
